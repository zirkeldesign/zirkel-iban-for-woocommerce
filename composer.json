{
    "name": "zirkeldesign/zirkel-iban-for-woocommerce",
    "description": "Accept reconciled bank transfer payments in WooCommerce via Stripe, with per-order virtual bank accounts and automatic webhook reconciliation.",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "keywords": [
        "wordpress",
        "woocommerce",
        "stripe",
        "bank-transfer",
        "sepa",
        "payments"
    ],
    "authors": [
        {
            "name": "zirkel.design",
            "email": "hello@zirkel.design",
            "homepage": "https://zirkel.design"
        },
        {
            "name": "Daniel Sturm",
            "email": "d.sturm@zirkeldesign.de",
            "homepage": "https://zirkel.design"
        }
    ],
    "homepage": "https://github.com/zirkeldesign/zirkel-iban-for-woocommerce",
    "support": {
        "issues": "https://github.com/zirkeldesign/zirkel-iban-for-woocommerce/issues",
        "source": "https://github.com/zirkeldesign/zirkel-iban-for-woocommerce"
    },
    "require": {
        "php": "^8.3",
        "stripe/stripe-php": "^22.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.0",
        "php-stubs/woocommerce-stubs": "^11.0",
        "php-stubs/wordpress-stubs": "^7.1",
        "phpstan/phpstan": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "ZirkelDesign\\BankTransfersForWooCommerce\\": "src/"
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "ZirkelDesign\\BankTransfersForWooCommerce\\Vendor\\",
            "classmap_prefix": "BTPW_Vendor_",
            "constant_prefix": "BTPW_STRIPE_",
            "packages": [
                "stripe/stripe-php"
            ],
            "delete_vendor_packages": true,
            "update_call_sites": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZirkelDesign\\BankTransfersForWooCommerce\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "dist": "bash scripts/build-dist.sh",
        "format": "pint",
        "format:test": "pint --test",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "pest",
        "translate:check": "php scripts/check-translations.php",
        "test:browser": "pest tests/Browser",
        "pcp": "bash bin/plugin-check.sh",
        "test:integration": "pest -c phpunit.integration.xml",
        "test:integration:setup": "./scripts/integration-env.sh",
        "test:e2e": "bash scripts/e2e.sh"
    }
}
